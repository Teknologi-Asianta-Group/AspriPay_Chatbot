"""
Query pipeline: pertanyaan pengunjung -> retrieval dari Qdrant -> generation via Mistral.

Ini implementasi dari flowchart_alur_chatbot_aspripay:
  pesan masuk -> query KB (retrieval) -> susun prompt -> inferensi LLM -> cek confidence
  -> jawab AI (kalau confidence cukup) / eskalasi ke agent (kalau tidak)

NOTE: Generator pakai Mistral API (cloud, free tier) supaya tidak memberatkan
hardware development. Qdrant + embedding tetap jalan lokal seperti semula.
"""

from dataclasses import dataclass

from haystack import Pipeline
from haystack.utils import Secret
from haystack_integrations.components.embedders.sentence_transformers import (
    SentenceTransformersTextEmbedder,
)
from haystack.components.builders import PromptBuilder
from haystack_integrations.document_stores.qdrant import QdrantDocumentStore
from haystack_integrations.components.retrievers.qdrant import QdrantEmbeddingRetriever
from haystack_integrations.components.generators.mistral import MistralGenerator

from app.core.config import settings


SYSTEM_PROMPT_TEMPLATE = """
Kamu adalah asisten customer service aspripay. Jawab pertanyaan pengunjung
HANYA berdasarkan konteks berikut. Kalau jawabannya tidak ada di konteks,
katakan dengan jujur bahwa kamu tidak tahu dan sarankan untuk menunggu agent.

Konteks:
{% for doc in documents %}
{{ doc.content }}
{% endfor %}

Riwayat percakapan:
{{ history }}

Pertanyaan pengunjung: {{ question }}

Jawaban:
"""


@dataclass
class RAGAnswer:
    answer: str
    confidence_score: float
    source_chunks: list  # list of document ids yang dipakai (buat MESSAGE_KB_CHUNK_REF)
    should_escalate: bool


def build_query_pipeline(document_store: QdrantDocumentStore) -> Pipeline:
    pipeline = Pipeline()

    pipeline.add_component(
        "text_embedder",
        SentenceTransformersTextEmbedder(
            model="sentence-transformers/paraphrase-multilingual-mpnet-base-v2"
        ),
    )
    pipeline.add_component(
        "retriever",
        QdrantEmbeddingRetriever(document_store=document_store, top_k=settings.TOP_K_RETRIEVAL),
    )
    pipeline.add_component("prompt_builder", PromptBuilder(template=SYSTEM_PROMPT_TEMPLATE))
    pipeline.add_component(
        "generator",
        MistralGenerator(
            api_key=Secret.from_token(settings.MISTRAL_API_KEY),
            model=settings.MISTRAL_MODEL,
            generation_kwargs={"temperature": 0.3},  # rendah biar jawaban lebih konsisten/faktual
        ),
    )

    pipeline.connect("text_embedder.embedding", "retriever.query_embedding")
    pipeline.connect("retriever.documents", "prompt_builder.documents")
    pipeline.connect("prompt_builder.prompt", "generator.prompt")

    return pipeline


def estimate_confidence(retrieved_docs: list) -> float:
    """
    Estimasi confidence sederhana berdasarkan skor similarity dokumen teratas.
    NOTE: ini heuristik awal, perlu dikalibrasi ulang pas testing manual nanti.
    """
    if not retrieved_docs:
        return 0.0
    top_score = retrieved_docs[0].score if hasattr(retrieved_docs[0], "score") else 0.0
    return round(top_score, 2)


def ask(pipeline: Pipeline, question: str, history: str = "") -> RAGAnswer:
    result = pipeline.run(
        {
            "text_embedder": {"text": question},
            "prompt_builder": {"question": question, "history": history},
        },
        include_outputs_from={"retriever"},
    )

    retrieved_docs = result.get("retriever", {}).get("documents", [])
    confidence = estimate_confidence(retrieved_docs)
    answer_text = result["generator"]["replies"][0]

    return RAGAnswer(
        answer=answer_text,
        confidence_score=confidence,
        source_chunks=[doc.id for doc in retrieved_docs],
        should_escalate=confidence < settings.CONFIDENCE_THRESHOLD,
    )
