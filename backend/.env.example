# Database
DATABASE_URL=

# Mistral (generator utama - cloud API free tier)
MISTRAL_API_KEY=isi_api_key_mistral_kamu_di_sini
MISTRAL_MODEL=mistral-small-latest

# Qdrant Cloud (vector store - free tier, tidak perlu Docker)
QDRANT_URL=
QDRANT_API_KEY=isi_api_key_qdrant_kamu_di_sini

# RAG behavior
CONFIDENCE_THRESHOLD=0.55
TOP_K_RETRIEVAL=3

# App
APP_ENV=development



# Cognee (knowledge graph memory layer - Cloud API)
COGNEE_API_KEY=<api_key_cognee_kamu>
COGNEE_BASE_URL=<base_url_tenant_cognee_kamu>
